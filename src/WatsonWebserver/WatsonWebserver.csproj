<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net8.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Version>7.3.0</Version>
		<Description>Simple, fast, async C# web server for handling REST requests with unified 7.x protocol architecture targeting .NET Standard 2.1, .NET 8, and .NET 10.</Description>
		<PackageReleaseNotes>Native AOT and trimming support (net8.0 and net10.0): the package is marked IsAotCompatible, Watson's own JSON (API errors, health checks, OpenAPI) uses source-generated metadata, and the new DefaultSerializationHelper(IJsonTypeInfoResolver) constructor accepts a JsonSerializerContext for application types. Non-AOT applications need no changes and produce identical JSON. See CHANGELOG.md.</PackageReleaseNotes>

		<Authors>Joel Christner</Authors>
		<Company>Joel Christner</Company>
		<Copyright>(c)2026 Joel Christner</Copyright>
		<PackageProjectUrl>https://github.com/dotnet/WatsonWebserver</PackageProjectUrl>
		<RepositoryUrl>https://github.com/dotnet/WatsonWebserver</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>watson webserver web-server rest restful aot nativeaot trimming http http2 http3 quic api async openapi swagger telemetry opentelemetry metrics tracing observability prometheus</PackageTags>
		<PackageId>Watson</PackageId>
		<Product>Watson</Product>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageIcon>watson.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Title>Watson Webserver</Title>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\WatsonWebserver.xml</DocumentationFile>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<!-- Native AOT and trimming: enables the trim, AOT, and single-file analyzers and marks the assembly trimmable. netstandard2.1 cannot be AOT compiled, so it is excluded. -->
	<PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="assets\watson.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="LICENSE.md">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Content Include="Core\Assets\watson.ico">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="IpMatcher" Version="1.1.0" />
		<PackageReference Include="RegexMatcher" Version="1.1.0" />
		<PackageReference Include="Timestamps" Version="1.0.13" />
		<PackageReference Include="UrlMatcher" Version="3.1.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
		<PackageReference Include="System.Text.Json" Version="10.0.12" />
		<PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.12" />
	</ItemGroup>

</Project>
