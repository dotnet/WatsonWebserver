<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net462;net48;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Version>7.3.0</Version>
    <Description>Async-first WebSocket client for Watson 7 with whole-message receive semantics, direct ClientWebSocket access, and interop with the Watson webserver WebSocket surface.</Description>
    <PackageReleaseNotes>Versioned in lockstep with Watson 7.3.0. Marked IsAotCompatible for net8.0 and net10.0 (no code changes were required; the client has no trim or AOT warnings).</PackageReleaseNotes>
    <Authors>Joel Christner</Authors>
    <Company>Joel Christner</Company>
    <Copyright>(c)2026 Joel Christner</Copyright>
    <PackageProjectUrl>https://github.com/dotnet/WatsonWebserver</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dotnet/WatsonWebserver</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>watson websocket web socket client async messaging</PackageTags>
    <PackageId>Watson.Clients</PackageId>
    <Product>Watson.Clients</Product>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageIcon>watson.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Title>Watson Clients</Title>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\Watson.Clients.xml</DocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Native AOT and trimming: enables the trim, AOT, and single-file analyzers and marks the assembly trimmable. -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\assets\watson.png" Link="watson.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\..\LICENSE.md" Link="LICENSE.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462' Or '$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
    <PackageReference Include="System.Buffers" Version="4.6.1" />
  </ItemGroup>

</Project>
